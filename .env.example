# Copy this file to ".env" (same folder) and fill in the values. NEVER share your .env file.

# REQUIRED: your bot token from the Discord Developer Portal (Bot tab -> Reset Token / Copy).
DISCORD_TOKEN=

# Timezone for every schedule. Default is the Philippines (UTC+8).
TIMEZONE=Asia/Manila

# OPTIONAL: your server's ID. If set, slash commands appear instantly in that server.
# (Discord: Settings > Advanced > turn on Developer Mode, then right-click your server > Copy Server ID.)
# If empty, commands are global and may take up to an hour to show up the first time.
GUILD_ID=1555611524985266186

# OPTIONAL: if true, only members with the "Manage Server" permission can add/edit/delete things.
RESTRICT_TO_MANAGERS=false

# OPTIONAL: if the bot was offline when a post was due, it still posts it (once) if it is no more
# than this many minutes late. Older missed posts are skipped. Default 360 (6 hours).
MISFIRE_GRACE_MINUTES=360

# OPTIONAL: where the SQLite database file lives (default: data/taskbot.db next to main.py).
DATABASE_PATH=

# OPTIONAL: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
